<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MenYou.ViewModels"
        xmlns:c="using:MenYou.Views.Converters"
        xmlns:layouts="using:MenYou.Views.Layouts"
        x:Class="MenYou.Views.StartMenuWindow"
        x:DataType="vm:StartMenuViewModel"
        Title="MenYou"
        Icon="avares://MenYou/Assets/icon_v2.ico"
        SizeToContent="WidthAndHeight"
        MinWidth="{Binding MenuMinWidth}" MinHeight="{Binding MenuMinHeight}"
        MaxWidth="980" MaxHeight="840"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, Inter"
        FontSize="13"
        CanResize="False">

    <Window.Styles>
        <!-- The app-wide theme is Fluid.Avalonia (see App.axaml). The
             StartMenu deliberately opts back out to Avalonia's stock
             FluentTheme so its tuned palette / brushes (Colors.axaml,
             Brushes.axaml) and all the built-in layouts render exactly as
             designed, unaffected by Fluid's Fluent-2 token overrides.
             Window-scoping FluentTheme is safe here — the StartMenu uses
             only directly-themed controls (no NumericUpDown-style
             composites that need an app-scope theme). -->
        <FluentTheme />

        <!-- A custom theme owns its whole edge: CustomThemeCornerRadiusConverter
             already squares RootBorder's corners so the window can't round off
             a theme that squares everything inside. But RootBorder still PAINTS
             MenuBackground, and an opaque square fill behind a theme that
             rounds ITSELF shows up as dark square corners around the curve —
             the theme looks square even though it isn't. Drop the fill for
             custom themes and let the theme paint its own background. -->
        <!-- RootBorder's default fill lives HERE, as a style, not as a local
             Background attribute on the element. A local value outranks every
             style setter in Avalonia, so while the fill was set inline the two
             class overrides below could never win: RootBorder painted
             MenuBackground behind custom themes all along, and behind the
             native backdrop too. Measured with MenYou on Light and Windows on
             dark: the "backdrop" interior read 250,250,250 — RootBorder's
             #FAFAFA, not Mica. Class-activated styles take precedence over this
             plain one, so the overrides now actually apply. -->
        <Style Selector="Border#RootBorder">
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
        </Style>
        <Style Selector="Border#RootBorder.customtheme">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Same for a native backdrop: Mica IS the surface there, so an opaque
             MenuBackground fill on top of it would hide the backdrop entirely.
             This replaces a StartMenuViewModel.PaintChromeBackground property
             that was meant to do the job but was never bound to anything. -->
        <Style Selector="Border#RootBorder.backdrop">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <c:EnumEqualsConverter x:Key="EnumEquals" />
    </Window.Resources>

    <!-- Edge treatment per the WindowBorder setting; outline and shadow are
         decoupled. The visible 1 px hairline (theme MenuBorderBrush) is set on
         RootBorder.BorderThickness in ApplyDwmWindowChrome — 1 only for the
         outlined styles (Windows11, Hairline); 0 for Subtle, None and custom.
         The drop shadow is an Avalonia BoxShadow bound to MenuShadow
         (Windows11 = soft, FullShade = strong all-around halo, Subtle =
         lighter, Hairline / None / custom = none),
         drawn by Skia into the transparent ShadowMargin band around the card —
         the transparent popup window can't receive a native DWM shadow.
         ClipToBounds MUST stay False here, or the outset shadow is clipped to
         nothing; the nested Border below is the real content clip mask. -->
    <Border x:Name="RootBorder"
            CornerRadius="{Binding UseCustomTheme, Converter={x:Static c:CustomThemeCornerRadiusConverter.Instance}}"
            BorderThickness="0"
            BorderBrush="{DynamicResource MenuBorderBrush}"
            Classes.customtheme="{Binding UseCustomTheme}"
            Classes.backdrop="{Binding IsBackdropActive}"
            Margin="{Binding ShadowMargin}"
            BoxShadow="{Binding MenuShadow}"
            ClipToBounds="False">
        <!-- Nested rounded Border acts as the real clip mask. Without
             it the rectangular backgrounds painted by the bottom
             action bar (search panel, power-button strip) overwrite
             the outer Border's rounded bottom corners — Avalonia 12's
             ClipToBounds on a Border with CornerRadius doesn't actually
             clip children to the rounded shape in every case. -->
        <Border CornerRadius="{Binding UseCustomTheme, Converter={x:Static c:CustomThemeCornerRadiusConverter.Instance}}" ClipToBounds="True">
            <Grid>
                <!-- Built-in layouts. Visible only when the master
                     "Use custom theme" toggle is off (the default). When
                     UseCustomTheme flips on at Apply, this entire group
                     hides and the ContentControl below takes over. -->
                <!-- Built-in layouts. Visible only when the master
                     "Use custom theme" toggle is off (the default). When
                     UseCustomTheme flips on at Apply, this entire group
                     hides and the ContentControl below takes over. -->
                <Grid IsVisible="{Binding !UseCustomTheme}">
                    <!-- Windows 11 first: it's the default style (see
                         UserSettings.MenuStyle), so it's the layout the
                         post-login warm-up renders on the common path. -->
                    <layouts:Windows11Layout
                        IsVisible="{Binding MenuStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Windows11}" />
                    <layouts:Win7Layout
                        IsVisible="{Binding MenuStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Win7}" />
                    <layouts:MintCinnamonLayout
                        IsVisible="{Binding MenuStyle, Converter={StaticResource EnumEquals}, ConverterParameter=MintCinnamon}" />
                    <layouts:Classic1Layout
                        IsVisible="{Binding MenuStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Classic1}" />
                    <layouts:Classic2Layout
                        IsVisible="{Binding MenuStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Classic2}" />
                </Grid>
                <!-- Custom theme. The same XamlStringToControlConverter
                     that powers the Settings → Custom preview is used here
                     in production: ContentControl.Content gets the parsed
                     control tree, or a red error TextBlock if the XAML
                     doesn't parse. Empty input renders the artboard
                     placeholder, which signals "you've enabled custom
                     theme but didn't supply any XAML yet" inside the
                     real menu (matching the preview behavior 1:1). -->
                <ContentControl IsVisible="{Binding UseCustomTheme}"
                                Content="{Binding CustomThemeXaml, Converter={x:Static c:XamlStringToControlConverter.Instance}}" />
            </Grid>
        </Border>
    </Border>
</Window>
