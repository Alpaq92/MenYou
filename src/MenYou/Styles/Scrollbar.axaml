<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Slim, modern ScrollBar + ScrollViewer ported from SukiUI
        (kikipoulet/SukiUI). The Avalonia Fluent default paints a chunky
        gray "TrackRect" when the bar enters its expanded state on
        pointer-over, and the theme keys that control it are hard to
        override cleanly. SukiUI sidesteps that by replacing the entire
        ScrollBar ControlTemplate with a slim Border thumb. The
        ScrollViewer template is also overridden so the surrounding
        Fluent chrome (corner separators, etc.) doesn't fight the slim
        bar.

        Interaction model (slim, focus-driven — the thumb stays a constant
        5 px and never grows):
        - Focused: the thumb is visible (Opacity 1) at its slim 5 px width
          whenever the scroll area can scroll — always there while you're
          using the menu, so you can see and grab it without hunting.
        - Pointer over the scroll area: the thumb only BRIGHTENS to the
          hover brush. AllowAutoHide is used purely as that pointer-over
          state flag (set precisely via /template/ so a hovered OUTER
          ScrollViewer doesn't brighten a nested inner one); it stays False
          otherwise, so the framework's own auto-hide fade never runs. Width
          is unchanged.
        - Host window not focused: StartMenuWindow toggles the
          "window-unfocused" class (code-behind OnActivated / OnDeactivated),
          and the Window.window-unfocused rules below fade the thumb out
          (Opacity 0). Those rules are intentionally LAST — Avalonia style
          precedence is order-based, so a later Opacity=0 wins over the
          default Opacity=1 while the window is inactive. Other windows
          (Settings) never set the class, so their slim bar is simply always
          visible.

        Side-menu (.Stack) variants from the upstream file were dropped
        — they depend on SukiUI's internal converters which we don't
        carry.
    -->

    <Style Selector="ScrollBar:vertical">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" UseLayoutRounding="False">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Track Grid.Row="1"
                               Grid.Column="1"
                               IsDirectionReversed="True"
                               Maximum="{TemplateBinding Maximum}"
                               Minimum="{TemplateBinding Minimum}"
                               Orientation="{TemplateBinding Orientation}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Background="Transparent"
                                              Classes="repeattrack"
                                              Focusable="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Background="Transparent"
                                              Classes="repeattrack"
                                              Focusable="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Panel>
                                            <Border Name="ThumbBarVertical"
                                                    Width="5"
                                                    Margin="0,3"
                                                    Opacity="1"
                                                    Background="{DynamicResource ScrollBarThumbRestBrush}"
                                                    CornerRadius="{DynamicResource ScrollBarThumbCornerRadius}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="Background" Duration="0:0:0.15" />
                                                        <DoubleTransition Property="Width" Duration="0:0:0.1" />
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                        </Panel>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" UseLayoutRounding="False">
                    <Grid>
                        <Track IsDirectionReversed="False"
                               Maximum="{TemplateBinding Maximum}"
                               Minimum="{TemplateBinding Minimum}"
                               Orientation="{TemplateBinding Orientation}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Background="Transparent"
                                              Classes="repeattrack"
                                              Focusable="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Background="Transparent"
                                              Classes="repeattrack"
                                              Focusable="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Panel>
                                            <Border Name="ThumbBarHorizontal"
                                                    Height="5"
                                                    Margin="3,0"
                                                    Opacity="1"
                                                    Background="{DynamicResource ScrollBarThumbRestBrush}"
                                                    CornerRadius="10">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="Background" Duration="0:0:0.15" />
                                                        <DoubleTransition Property="Height" Duration="0:0:0.1" />
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                        </Panel>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Pointer-over BRIGHTEN only (slim 5 px width unchanged). /template/ sets
         the flag on the ScrollViewer's OWN bar precisely (one hop), so a hovered
         outer ScrollViewer doesn't also brighten a nested inner one. -->
    <Style Selector="ScrollViewer:pointerover /template/ ScrollBar">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <Style Selector="ScrollBar[AllowAutoHide=True] Border#ThumbBarVertical">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
    </Style>

    <Style Selector="ScrollBar[AllowAutoHide=True] Border#ThumbBarHorizontal">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
    </Style>

    <!-- Hidden while the host window isn't focused (StartMenuWindow toggles the
         "window-unfocused" class in OnActivated / OnDeactivated). MUST stay after
         the rules above: Avalonia style precedence is order-based, so this later
         Opacity=0 overrides the default Opacity=1 while the window is inactive.
         Reuses the thumb's Opacity DoubleTransition for a smooth fade. Only
         StartMenuWindow sets the class; other windows keep the slim bar visible. -->
    <!-- :is(Window) — NOT bare "Window": a bare type name is an exact-type
         (OfType) selector, and the live control is the subclass StartMenuWindow,
         so "Window" would never match and the hide would silently never fire.
         :is(Window) matches Window and its subclasses. -->
    <Style Selector=":is(Window).window-unfocused Border#ThumbBarVertical">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector=":is(Window).window-unfocused Border#ThumbBarHorizontal">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Single-cell Grid so the scrollbars overlay the content
                     rather than reserving their own row/column. The slim
                     5 px bars sit at the bottom/right edge of the viewport
                     instead of carving out a permanent strip beneath the
                     content (which would read as a stray gray line under the
                     Pinned tile row). Overlaying is what lets the bar be
                     visible-when-focused without shifting or squeezing the
                     content beside it. -->
                <Grid>
                    <ScrollContentPresenter Name="PART_ContentPresenter"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                            HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                            ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}"
                                            VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                            VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}">
                        <ScrollContentPresenter.GestureRecognizers>
                            <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                                     CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                                     IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}" />
                        </ScrollContentPresenter.GestureRecognizers>
                    </ScrollContentPresenter>
                    <ScrollBar Name="PART_HorizontalScrollBar"
                               Orientation="Horizontal"
                               VerticalAlignment="Bottom" />
                    <ScrollBar Name="PART_VerticalScrollBar"
                               Orientation="Vertical"
                               HorizontalAlignment="Right" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
