<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:MenYou.Views.Behaviors">
    <!--
        Slim, modern ScrollBar + ScrollViewer ported from SukiUI
        (kikipoulet/SukiUI). The Avalonia Fluent default paints a chunky
        gray "TrackRect" when the bar enters its expanded state on
        pointer-over, and the theme keys that control it are hard to
        override cleanly. SukiUI sidesteps that by replacing the entire
        ScrollBar ControlTemplate with a slim Border thumb. The
        ScrollViewer template is also overridden so the surrounding
        Fluent chrome (corner separators, etc.) doesn't fight the slim
        bar.

        Interaction model (overlay — hidden unless the user is interacting
        with the scroll area; the thumb stays a constant 5 px and never
        grows):
        - At rest: the thumb is fully transparent (Opacity 0), so nothing
          shows over uniform content.
        - Pointer over the scroll area, OR the area actively scrolling
          (wheel / keyboard / programmatic — ScrollActivityBehavior pulses
          the "scrolling" class while the offset moves, lingering ~1 s):
          the thumb fades in at its slim width with the hover brush.
          AllowAutoHide is used purely as that show-state flag (set
          precisely via /template/ so a hovered or scrolling OUTER
          ScrollViewer doesn't light up a nested inner one); it stays False
          otherwise, so the framework's own auto-hide fade never runs.

        Side-menu (.Stack) variants from the upstream file were dropped
        — they depend on SukiUI's internal converters which we don't
        carry.
    -->

    <Style Selector="ScrollBar:vertical">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" UseLayoutRounding="False">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Track Grid.Row="1"
                               Grid.Column="1"
                               IsDirectionReversed="True"
                               Maximum="{TemplateBinding Maximum}"
                               Minimum="{TemplateBinding Minimum}"
                               Orientation="{TemplateBinding Orientation}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Background="Transparent"
                                              Classes="repeattrack"
                                              Focusable="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Background="Transparent"
                                              Classes="repeattrack"
                                              Focusable="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Panel>
                                            <Border Name="ThumbBarVertical"
                                                    Width="5"
                                                    Margin="0,3"
                                                    Opacity="0"
                                                    Background="{DynamicResource ScrollBarThumbRestBrush}"
                                                    CornerRadius="{DynamicResource ScrollBarThumbCornerRadius}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="Background" Duration="0:0:0.15" />
                                                        <DoubleTransition Property="Width" Duration="0:0:0.1" />
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                        </Panel>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" UseLayoutRounding="False">
                    <Grid>
                        <Track IsDirectionReversed="False"
                               Maximum="{TemplateBinding Maximum}"
                               Minimum="{TemplateBinding Minimum}"
                               Orientation="{TemplateBinding Orientation}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Background="Transparent"
                                              Classes="repeattrack"
                                              Focusable="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Background="Transparent"
                                              Classes="repeattrack"
                                              Focusable="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Panel>
                                            <Border Name="ThumbBarHorizontal"
                                                    Height="5"
                                                    Margin="3,0"
                                                    Opacity="0"
                                                    Background="{DynamicResource ScrollBarThumbRestBrush}"
                                                    CornerRadius="10">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="Background" Duration="0:0:0.15" />
                                                        <DoubleTransition Property="Height" Duration="0:0:0.1" />
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                        </Panel>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Show the bar while the user is INTERACTING with the scroll area:
         pointer over it, or its offset actively moving (the "scrolling" class,
         pulsed by ScrollActivityBehavior with a ~1 s linger). /template/ sets
         the flag on the ScrollViewer's OWN bar precisely (one hop), so a
         hovered or scrolling outer ScrollViewer doesn't light up a nested
         inner one. -->
    <Style Selector="ScrollViewer:pointerover /template/ ScrollBar">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <Style Selector="ScrollViewer.scrolling /template/ ScrollBar">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <Style Selector="ScrollBar[AllowAutoHide=True] Border#ThumbBarVertical">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
    </Style>

    <Style Selector="ScrollBar[AllowAutoHide=True] Border#ThumbBarHorizontal">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
    </Style>

    <Style Selector="ScrollViewer">
        <!-- Every ScrollViewer reports scroll activity, so the show-on-
             scrolling rule above works app-wide (lists, trees, flyouts). -->
        <Setter Property="(behaviors:ScrollActivityBehavior.Enable)" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Single-cell Grid so the scrollbars overlay the content
                     rather than reserving their own row/column. The slim
                     5 px bars sit at the bottom/right edge of the viewport
                     instead of carving out a permanent strip beneath the
                     content (which would read as a stray gray line under the
                     Pinned tile row). Overlaying is what lets the bar be
                     visible-when-focused without shifting or squeezing the
                     content beside it. -->
                <Grid>
                    <ScrollContentPresenter Name="PART_ContentPresenter"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                            HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                            ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}"
                                            VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                            VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}">
                        <ScrollContentPresenter.GestureRecognizers>
                            <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                                     CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                                     IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}" />
                        </ScrollContentPresenter.GestureRecognizers>
                    </ScrollContentPresenter>
                    <ScrollBar Name="PART_HorizontalScrollBar"
                               Orientation="Horizontal"
                               VerticalAlignment="Bottom" />
                    <ScrollBar Name="PART_VerticalScrollBar"
                               Orientation="Vertical"
                               HorizontalAlignment="Right" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
